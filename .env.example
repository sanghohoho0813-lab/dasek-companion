# ─────────────────────────────────────────────────────────────
# 다색컴패니언 환경 변수 예시 — 실제 값은 .env.local 에만 넣고 커밋하지 마세요.
# 현재(1차 빌드)는 아래 값이 없어도 DEMO 모드(브라우저 저장)로 전체 흐름이 동작합니다.
# ─────────────────────────────────────────────────────────────

# [초안·미연결] Supabase — 키만 넣어서는 동작하지 않습니다. 앱에 Supabase 어댑터·서버 RPC가 아직 없습니다.
# 운영 전환 절차: docs/LIVE_TRANSITION_CHECKLIST.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# [READY] LLM(선택) — 캠페인 문안 초안·쉬운 설명. 서버 Route에서만 사용.
ANTHROPIC_API_KEY=

# [NOT CONNECTED] 외부 채널 — 권리·동의·요금 확인 전 발송 금지
KAKAO_BIZMESSAGE_KEY=
